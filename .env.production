# Phyntom X8 Console — production defaults
#
# The static site on mega-x.ai (Amplify) has NO FastAPI backend behind /v1/*,
# so this stays `true` and console/src/lib/mocks.ts serves fixture data for
# every Console REST route. Exception: the Builders Studio chat pane rides the
# Recruiter WebSocket (/v1/dev/recruiter/ws), which a fetch-level mock cannot
# intercept — it needs the real backend.
#
# When the backend (platform/ai_native/main.py) is deployed and routed
# (e.g. nginx /v1/* → upstream FastAPI), set this to `false` and re-build.
VITE_USE_MOCK=true
